        <Param val="1080" valType="code" updates="None" name="operatorYRes"/>
        <Param val="False" valType="bool" updates="None" name="recordEyeImagesDuringCalibration"/>
        <Param val="" valType="code" updates="None" name="samplingRate"/>
        <Param val="False" valType="bool" updates="None" name="samplingRateManual"/>
        <Param val="Tobii Pro Spectrum" valType="str" updates="None" name="tracker"/>
        <Param val="" valType="str" updates="None" name="trackerAddress"/>
        <Param val="Default" valType="str" updates="None" name="trackingMode"/>
        <Param val="False" valType="bool" updates="None" name="verbose"/>
      </TittaInitComponent>
      <TextComponent name="gaze_question" plugin="None">
        <Param val="white" valType="color" updates="constant" name="color"/>
        <Param val="rgb" valType="str" updates="constant" name="colorSpace"/>
        <Param val="1" valType="num" updates="constant" name="contrast"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
