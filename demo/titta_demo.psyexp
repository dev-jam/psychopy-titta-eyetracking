    <Param val="0.5" valType="num" updates="None" name="mgSaccade"/>
    <Param val="0" valType="code" updates="None" name="runMode"/>
    <Param val="False" valType="bool" updates="None" name="rush"/>
    <Param val="time" valType="str" updates="None" name="sortColumns"/>
    <Param val="pyglet" valType="str" updates="None" name="winBackend"/>
  </Settings>
  <Routines>
    <Routine name="setup">
      <RoutineSettingsComponent name="setup" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="Simple demo eye tracking experiment for the Titta PsychoPy plugin (psychopy-titta-eyetracking), the same as the demo of the Titta OpenSesame plugin.&amp;#10;&amp;#10;By default it runs in dummy mode. To connect to a Tobii eye tracker, set Dummy mode to No in the 'titta' component (routine 'setup') and select the eye tracker.&amp;#10;&amp;#10;The experiment asks whether to plot the gaze on the stimulus screen after each stimulus. In dummy mode the gaze moves in a circle; with an eye tracker it is the real gaze. Press space to go on. Eye tracking data: data/&lt;participant&gt;_titta_demo_&lt;date&gt;.h5 (and tsv files) next to the PsychoPy data file.&amp;#10;&amp;#10;The pictures and the data are compatible with the demo analysis of Titta: https://github.com/marcus-nystrom/Titta" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="setup" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <TittaInitComponent name="titta" plugin="psychopy-titta-eyetracking">
        <Param val="False" valType="bool" updates="None" name="bimonocularCalibration"/>
        <Param val="True" valType="bool" updates="None" name="calibrationAnimate"/>
        <Param val="Autoaccept (default)" valType="str" updates="None" name="calibrationAutoPace"/>
        <Param val="Thaler (default)" valType="str" updates="None" name="calibrationDot"/>
        <Param val="30" valType="code" updates="None" name="calibrationDotSize"/>
        <Param val="False" valType="bool" updates="None" name="calibrationManual"/>
        <Param val="0.5" valType="code" updates="None" name="calibrationMovementDuration"/>
        <Param val="1.0" valType="code" updates="None" name="calibrationPacingInterval"/>
        <Param val="thisExp.dataFileName" valType="code" updates="None" name="dataFileName"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="Yes" valType="str" updates="None" name="dummyMode"/>
        <Param val="" valType="code" updates="None" name="headBoxCenterX"/>
        <Param val="" valType="code" updates="None" name="headBoxCenterY"/>
        <Param val="" valType="code" updates="None" name="headBoxCenterZ"/>
        <Param val="False" valType="bool" updates="None" name="headBoxManual"/>
        <Param val="5" valType="str" updates="None" name="nCalibrationTargets"/>
        <Param val="titta" valType="code" updates="None" name="name"/>
        <Param val="False" valType="bool" updates="None" name="operatorScreen"/>
        <Param val="default" valType="str" updates="None" name="operatorScreenName"/>
        <Param val="1" valType="code" updates="None" name="operatorScreenNr"/>
        <Param val="False" valType="bool" updates="None" name="operatorWaitBlanking"/>
