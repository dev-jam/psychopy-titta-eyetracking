#!/usr/bin/make -f

export PYBUILD_NAME = psychopy_titta_eyetracking
# The tests need PsychoPy, which is not in Debian yet.
export PYBUILD_DISABLE = test

%:
	dh $@ --buildsystem=pybuild

# The run-time dependencies are listed in debian/control: guessing them
# from the wheel would miss the Debian names of packages that dh-python
# doesn't know (python3-titta).
override_dh_python3:
	dh_python3 --no-guessing-deps

override_dh_installchangelogs:
	dh_installchangelogs CHANGELOG.md
